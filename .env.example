# Copy this file to .env and fill in the values. Never commit .env.
# All values below are placeholders. None of them is a working credential.

# Identity the server uses to read and write Key Vault secrets.
# Read by DefaultAzureCredential from @azure/identity (service principal with client secret).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# Microsoft sign-in for users (authorization code flow, nuxt-auth-utils).
# Use your tenant ID as the tenant. Do not use "common" or "organizations":
# the app does not check which tenant a signed-in user belongs to.
NUXT_OAUTH_MICROSOFT_TENANT=00000000-0000-0000-0000-000000000000
NUXT_OAUTH_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
NUXT_OAUTH_MICROSOFT_CLIENT_SECRET=
NUXT_OAUTH_MICROSOFT_REDIRECT_URL=http://localhost:3000/api/auth/microsoft

# The key that seals the session cookie is not listed here on purpose.
# "pnpm dev" appends it to .env on first start. See "Configuration" in the README
# for the variable name and for production use.
